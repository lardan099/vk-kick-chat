{
  "manifest_version": 3,
  "name": "Merged Chat (Kick + VK Play Live)",
  "short_name": "Merged Chat",
  "version": "6.43",
  "description": "Единая лента чатов Kick и VK Play Live. Нужные вкладки держит в фоне сам, обновляется в один клик.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Merged Chat",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "cookies"
  ],
  "host_permissions": [
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://live.vkvideo.ru/*",
    "https://api.live.vkvideo.ru/*",
    "https://7tv.io/*",
    "https://pzdcflix.live/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/popout/*/chat*",
        "https://dashboard.kick.com/*",
        "https://live.vkvideo.ru/*/only-chat*",
        "https://live.vkvideo.ru/*/stream/*only-chat*",
        "https://live.vkvideo.ru/*/studio*",
        "https://live.vkvideo.ru/robots.txt*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/popout/*/chat*",
        "https://dashboard.kick.com/*",
        "https://live.vkvideo.ru/*/only-chat*",
        "https://live.vkvideo.ru/*/stream/*only-chat*",
        "https://live.vkvideo.ru/*/studio*",
        "https://live.vkvideo.ru/robots.txt*"
      ],
      "js": [
        "gm-shim.js",
        "chat.js",
        "ext-ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
